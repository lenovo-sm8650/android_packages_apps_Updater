<resources>
    <!-- Base background of the header card. -->
    <color name="brand_primary">#167C80</color>

    <!-- Tiled pattern overlay color for the header card. -->
    <color name="brand_pattern">#48A0A3</color>

    <!-- Content color on the header (text, icons, mark). Always white on teal. -->
    <color name="on_brand_surface">#FFFFFF</color>

    <!-- Sheen gradient color -->
    <color name="brand_sheen">#EADDFF</color>

    <!-- Whether this product supports update_engine performance mode. -->
    <bool name="config_ab_perf_mode">true</bool>

    <!-- Whether major Android-version OTAs may be installed in the app. -->
    <bool name="config_allowMajorUpgrades">true</bool>

    <!-- Whether the recovery update option should be hidden. -->
    <bool name="config_hideRecoveryUpdate">false</bool>

    <!-- Whether a compatible certified-build-properties overlay is provided. -->
    <bool name="config_showCertifiedPropsUpdate">true</bool>

</resources>
